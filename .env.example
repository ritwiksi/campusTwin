VITE_CESIUM_ION_TOKEN=your_cesium_ion_token_here

# Optional Snowflake Peak Detective integration.
# The ordinary demo does NOT need Snowflake: false uses a verified
# Snowflake-generated snapshot when present, otherwise a labeled local preview.
SNOWFLAKE_ENABLED=false
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
# If your local Snowflake login uses SSO, set this to externalbrowser;
# leave SNOWFLAKE_PASSWORD blank in that case. SSO is for local snapshot generation.
SNOWFLAKE_AUTHENTICATOR=snowflake
